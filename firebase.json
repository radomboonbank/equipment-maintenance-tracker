{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      ".git/**",
      ".github/**",
      ".*",
      "*.zip",
      "*import*.json",
      "functions/**",
      "TELEGRAM-SETUP.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "telegram",
      "ignore": [
        "node_modules",
        ".git",
        "*.test.js",
        ".env*"
      ]
    }
  ]
}
