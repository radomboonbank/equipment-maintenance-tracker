rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function account() { return request.auth != null && exists(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)); }
  function role() { return get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.role; }
  function editor() { return account() && role() in ['admin', 'editor']; }
  function admin() { return account() && role() == 'admin'; }
  function superAdmin() { return admin() && get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.get('duty', '') == 'super admin'; }
  function followup(v) {
   return v is map && v.keys().hasOnly(['date','time','informant','mobile','details','follower'])
    && v.date is string && v.time is string && v.informant is string && v.mobile is string && v.details is string && v.follower is string
    && v.date.size() <= 10 && v.time.size() <= 5 && v.informant.size() <= 250 && v.mobile.size() <= 250 && v.details.size() <= 4000 && v.follower.size() <= 250;
  }
  function valid() {
   let d = request.resource.data;
   return d.code is string && d.equipment is string && d.station is string
    && d.code.size() > 0 && d.code.size() <= 250 && d.equipment.size() > 0 && d.equipment.size() <= 4000
    && d.status in ['unreviewed', 'pending', 'repairing', 'resolved']
    && d.priority in ['normal', 'urgent', 'critical'] && d.history is list
    && d.revision is int && d.revision > 0
    && d.followups is list && d.followups.size() == 3
    && followup(d.followups[0]) && followup(d.followups[1]) && followup(d.followups[2])
    && (!('eventType' in d) || d.eventType in ['อุปกรณ์ขัดข้อง','Abnormal Alarm','Winding Temp Alarm','โครงการก่อสร้าง','งานบำรุงรักษาเกินกำหนด','ข้อจำกัด ระบบส่ง','Power Flow Control'])
    && closure(d) && criticalityValid(d) && (!('repairPlan' in d) || repairPlanValid(d.repairPlan));
  }
  function repairPlanValid(p) {
   return p is map && p.keys().hasAll(['approach','responsible','schedule','expectedDate'])
    && p.keys().hasOnly(['approach','responsible','schedule','expectedDate'])
    && p.approach is string && p.responsible is string && p.schedule is string && p.expectedDate is string
    && p.approach.size() <= 4000 && p.responsible.size() <= 4000 && p.schedule.size() <= 4000
    && (p.expectedDate == '' || p.expectedDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
  }
  function criticalityValid(d) {
   return !('criticality' in d) || (d.criticality in ['high','medium','low']
    && ('criticalityAssessment' in d ? assessmentValid(d) : d.criticality != 'high'));
  }
  function assessmentValid(d) {
   let a = d.criticalityAssessment;
   return a is map && a.keys().hasAll(['scope','replacement','effect','measures'])
    && a.keys().hasOnly(['scope','replacement','effect','measures'])
    && a.scope is string && a.replacement is string && a.effect is string && a.measures is string
    && a.scope.size() <= 4000 && a.replacement.size() <= 4000 && a.effect.size() <= 4000 && a.measures.size() <= 4000
    && (d.criticality != 'high' || (a.scope.matches('(?s).*\\S.*') && a.replacement.matches('(?s).*\\S.*') && a.effect.matches('(?s).*\\S.*') && a.measures.matches('(?s).*\\S.*')));
  }
  function closure(d) {
   let c = d.closure;
   return c is map && c.keys().hasOnly(['date','time','reporter','mobile','details','follower'])
    && c.date is string && c.time is string && c.reporter is string && c.mobile is string && c.details is string && c.follower is string
    && c.date.size() <= 10 && c.time.size() <= 5 && c.reporter.size() <= 250 && c.mobile.size() <= 250 && c.details.size() <= 4000 && c.follower.size() <= 250
    && ((d.status == 'resolved' && c.date.size() == 10 && c.time.size() == 5 && c.reporter.size() > 0 && c.mobile.size() > 0 && c.details.size() > 0 && c.follower.size() > 0)
     || (d.status != 'resolved' && c.date == '' && c.time == '' && c.reporter == '' && c.mobile == '' && c.details == '' && c.follower == ''));
  }
  match /equipment/{id} {
   allow read: if true;
   allow create: if editor() && valid() && queued(id) && request.resource.data.id == id && request.resource.data.revision == 1;
   allow update: if editor() && valid() && queued(id) && request.resource.data.id == resource.data.id && request.resource.data.code == resource.data.code && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if admin();
  }
  match /DatabaseLogin/{uid} {
   allow get: if (request.auth != null && request.auth.uid == uid) || superAdmin();
   allow list: if superAdmin();
   allow create, update, delete: if false;
  }

  // Public projection contains only names and login times, never employee IDs or UIDs.
  match /publicLoginHistory/{id} {
   allow get: if id == 'recent';
   allow list, delete: if false;
   allow create: if id == 'recent' && validPublicLogin()
    && request.resource.data.second == null && request.resource.data.third == null && request.resource.data.fourth == null && request.resource.data.fifth == null && request.resource.data.sixth == null && request.resource.data.seventh == null && request.resource.data.eighth == null && request.resource.data.ninth == null && request.resource.data.tenth == null;
   allow update: if id == 'recent' && validPublicLogin()
    && request.resource.data.second == resource.data.first && request.resource.data.third == resource.data.second && request.resource.data.fourth == resource.data.third && request.resource.data.fifth == resource.data.fourth && request.resource.data.sixth == resource.data.fifth && request.resource.data.seventh == resource.data.sixth && request.resource.data.eighth == resource.data.seventh && request.resource.data.ninth == resource.data.eighth && request.resource.data.tenth == resource.data.ninth;
  }
  function validPublicLogin() {
   let d=request.resource.data;
   return account() && role() in ['admin','editor','viewer']
    && d.keys().hasAll(['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth']) && d.keys().hasOnly(['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth'])
    && d.first is map && d.first.keys().hasAll(['displayName','at']) && d.first.keys().hasOnly(['displayName','at'])
    && d.first.displayName == get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.get('displayName', get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.username)
    && d.first.at == request.time;
  }
  match /loginHistory/{id} {
   allow get: if account() && role() in ['admin','editor','viewer'] && id == 'recent';
   allow list, delete: if false;
   allow create: if account() && role() in ['admin','editor','viewer'] && id == 'recent' && validLogin()
    && request.resource.data.second == null && request.resource.data.third == null;
   allow update: if account() && role() in ['admin','editor','viewer'] && id == 'recent' && validLogin()
    && request.resource.data.second == resource.data.first
    && request.resource.data.third == resource.data.second;
  }
  function validLogin() {
   let d = request.resource.data;
   return d.keys().hasAll(['first','second','third']) && d.keys().hasOnly(['first','second','third'])
    && d.first is map && d.first.keys().hasAll(['uid','username','at']) && d.first.keys().hasOnly(['uid','username','displayName','at'])
    && d.first.uid == request.auth.uid
    && d.first.username == get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.username
    && (!('displayName' in d.first) || d.first.displayName == get(/databases/$(database)/documents/DatabaseLogin/$(request.auth.uid)).data.get('displayName', d.first.username))
    && d.first.at == request.time;
  }

  match /metadata/systemAssessment { allow get: if account(); }
  match /metadata/{id} { allow read: if editor(); allow write: if admin(); }
  match /memberOperations/{id} {
   allow get: if superAdmin() && resource.data.actor == request.auth.uid;
   allow list, create, update, delete: if false;
  }
  match /members/{uid} { allow read, write: if false; }
  match /telegramDeliveries/{id} { allow read, write: if false; }
  function queued(id) {
   let key = id + '__' + string(request.resource.data.revision);
   let q = getAfter(/databases/$(database)/documents/telegramOutbox/$(key)).data;
   return q.record == request.resource.data && q.createdBy == request.auth.uid && q.createdAt == request.time && q.status == 'pending';
  }
  match /telegramOutbox/{key} {
   allow get: if editor() && resource.data.createdBy == request.auth.uid;
   allow list, update, delete: if false;
   allow create: if editor() && queueValid(key);
  }
  function queueValid(key) {
   let q = request.resource.data;
   let path = /databases/$(database)/documents/equipment/$(q.recordId);
   return q.keys().hasOnly(['recordId','revision','record','createdBy','createdAt','readyAt','status','nextPart','attempts'])
    && q.recordId is string && q.revision is int && q.record is map
    && key == q.recordId + '__' + string(q.revision)
    && q.createdBy == request.auth.uid && q.createdAt == request.time && q.readyAt == request.time
    && q.status == 'pending' && q.nextPart == 0 && q.attempts == 0
    && getAfter(path).data == q.record && q.record.revision == q.revision
    && ((!exists(path) && q.revision == 1) || (exists(path) && get(path).data.revision + 1 == q.revision));
  }
 }
}
